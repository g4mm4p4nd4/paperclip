{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperclip.local/schemas/provider-policy.v2.schema.json",
  "title": "Paperclip Provider Policy v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "revision",
    "updatedAt",
    "runtimeClosures",
    "aliases",
    "routes",
    "budgetClasses",
    "invariants"
  ],
  "properties": {
    "schemaVersion": {
      "const": "provider-policy.v2"
    },
    "policyId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "runtimeClosures": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/runtimeClosure"
      }
    },
    "aliases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_fast",
        "research_deep",
        "code_fast",
        "code_deep",
        "multimodal_qa",
        "independent_review",
        "summarization",
        "emergency_free"
      ],
      "properties": {
        "research_fast": {
          "$ref": "#/$defs/alias"
        },
        "research_deep": {
          "$ref": "#/$defs/alias"
        },
        "code_fast": {
          "$ref": "#/$defs/alias"
        },
        "code_deep": {
          "$ref": "#/$defs/alias"
        },
        "multimodal_qa": {
          "$ref": "#/$defs/alias"
        },
        "independent_review": {
          "$ref": "#/$defs/alias"
        },
        "summarization": {
          "$ref": "#/$defs/alias"
        },
        "emergency_free": {
          "$ref": "#/$defs/alias"
        }
      }
    },
    "routes": {
      "type": "object",
      "minProperties": 6,
      "propertyNames": {
        "pattern": "^[a-z0-9_\\-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/route"
      }
    },
    "budgetClasses": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/budgetClass"
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paperclipOwnsEscalation",
        "hermesFallback",
        "freshTranscriptOnRouteChange",
        "independentReviewDifferentProviderFamily",
        "emergencyFreeReleaseAllowed"
      ],
      "properties": {
        "paperclipOwnsEscalation": {
          "const": true
        },
        "hermesFallback": {
          "const": false
        },
        "freshTranscriptOnRouteChange": {
          "const": true
        },
        "independentReviewDifferentProviderFamily": {
          "const": true
        },
        "emergencyFreeReleaseAllowed": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderedRouteIds",
        "budgetClass",
        "capabilities"
      ],
      "properties": {
        "orderedRouteIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "budgetClass": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "model": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value",
            "version"
          ],
          "properties": {
            "kind": {
              "const": "exact"
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "family",
            "selector",
            "version"
          ],
          "properties": {
            "kind": {
              "const": "selector"
            },
            "family": {
              "type": "string",
              "minLength": 1
            },
            "selector": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "providerFamily",
        "model",
        "modelFamily",
        "transport",
        "runtimeBinding",
        "capabilities",
        "costRank",
        "billingMode",
        "credentialRef",
        "releaseAllowed",
        "emergencyOnly",
        "discovery",
        "canary",
        "rollback"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "providerFamily": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "modelFamily": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "enum": [
            "hermes",
            "direct_api",
            "subscription_cli"
          ]
        },
        "runtimeBinding": {
          "$ref": "#/$defs/runtimeBinding"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "costRank": {
          "type": "integer",
          "minimum": 0
        },
        "billingMode": {
          "enum": [
            "free",
            "subscription",
            "metered"
          ]
        },
        "credentialRef": {
          "type": "string",
          "pattern": "^(company-secret|runtime-auth)://[A-Za-z0-9_./-]+$"
        },
        "releaseAllowed": {
          "type": "boolean"
        },
        "emergencyOnly": {
          "type": "boolean"
        },
        "discovery": {
          "$ref": "#/$defs/discovery"
        },
        "canary": {
          "$ref": "#/$defs/canary"
        },
        "rollback": {
          "$ref": "#/$defs/rollback"
        }
      }
    },
    "runtimeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapterType",
        "commandRealpath",
        "commandSha256",
        "expectedVersion",
        "versionArgs",
        "credentialEnvNames",
        "isolatedCanaryCwd",
        "isolatedCanaryProfile",
        "hiddenFallbackDisabled",
        "maxCanaryInputTokens",
        "runtimeClosureId"
      ],
      "properties": {
        "adapterType": {
          "enum": [
            "hermes_local",
            "codex_cli",
            "claude_cli",
            "gemini_cli",
            "direct_api"
          ]
        },
        "commandRealpath": {
          "type": "string",
          "pattern": "^/[^\\u0000]+$"
        },
        "commandSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expectedVersion": {
          "type": "string",
          "minLength": 1
        },
        "versionArgs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "credentialEnvNames": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "isolatedCanaryCwd": {
          "const": true
        },
        "isolatedCanaryProfile": {
          "const": true
        },
        "hiddenFallbackDisabled": {
          "const": true
        },
        "maxCanaryInputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "runtimeClosureId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
        },
        "repoRoot": {
          "type": "string",
          "pattern": "^/[^\\u0000]+$"
        },
        "gitRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "gitTree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "criticalModules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "criticalModulesSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requireCleanTree": {
          "const": true
        },
        "externalAdapter": {
          "$ref": "#/$defs/sourceBinding"
        }
      }
    },
    "runtimeClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "files",
        "directories"
      ],
      "properties": {
        "schemaVersion": {
          "const": "provider-runtime-closure.v1"
        },
        "kind": {
          "enum": [
            "native_binary",
            "node_bundle",
            "python_venv"
          ]
        },
        "interpreter": {
          "$ref": "#/$defs/runtimeInterpreter"
        },
        "files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/runtimeFile"
          }
        },
        "directories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/runtimeDirectoryManifest"
          }
        }
      }
    },
    "runtimeInterpreter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationPath",
        "realpath",
        "sha256",
        "expectedVersion",
        "versionArgs",
        "shebang"
      ],
      "properties": {
        "invocationPath": {
          "type": "string",
          "pattern": "^/[^\\u0000]+$"
        },
        "realpath": {
          "type": "string",
          "pattern": "^/[^\\u0000]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expectedVersion": {
          "type": "string",
          "minLength": 1
        },
        "versionArgs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "shebang": {
          "type": "string",
          "pattern": "^#![^\\r\\n]+$"
        },
        "pathCommand": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    },
    "runtimeFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[^\\u0000]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "runtimeDirectoryManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "manifestSha256",
        "fileCount",
        "totalBytes",
        "rejectSymlinks"
      ],
      "properties": {
        "root": {
          "type": "string",
          "pattern": "^/[^\\u0000]+$"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fileCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        "rejectSymlinks": {
          "const": true
        }
      }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repoRoot",
        "gitRevision",
        "gitTree",
        "criticalModules",
        "criticalModulesSha256",
        "requireCleanTree"
      ],
      "properties": {
        "repoRoot": {
          "type": "string",
          "pattern": "^/[^\\u0000]+$"
        },
        "gitRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "gitTree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "criticalModules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "criticalModulesSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requireCleanTree": {
          "const": true
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "method",
        "catalogProviderKey",
        "requiredStatus",
        "versionSource",
        "selectedEntrySchema",
        "refreshSeconds",
        "requireExactVersion"
      ],
      "properties": {
        "authority": {
          "enum": [
            "models.dev",
            "runtime_cli"
          ]
        },
        "method": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "catalogProviderKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "requiredStatus": {
          "const": "active"
        },
        "versionSource": {
          "enum": [
            "verified_catalog",
            "runtime_cli_model_id"
          ]
        },
        "selectedEntrySchema": {
          "enum": [
            "provider-catalog-selected-entry.v1",
            "runtime-model-selected-entry.v1"
          ]
        },
        "refreshSeconds": {
          "type": "integer",
          "minimum": 1800
        },
        "requireExactVersion": {
          "const": true
        }
      }
    },
    "canary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "maxTokens",
        "timeoutSeconds",
        "successCriteria"
      ],
      "properties": {
        "kind": {
          "enum": [
            "zero_token",
            "minimal_token",
            "work_bearing"
          ]
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 0
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "successCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "cooldownSeconds",
        "failureThreshold",
        "requirePreviousRevision"
      ],
      "properties": {
        "action": {
          "const": "return_to_alias_resolution"
        },
        "cooldownSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "requirePreviousRevision": {
          "const": true
        }
      }
    },
    "budgetClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxTurns",
        "maxContextChars",
        "maxOutputChars",
        "maxTotalTokens",
        "toolOutput",
        "maxEscalations"
      ],
      "properties": {
        "maxTurns": {
          "type": "integer",
          "minimum": 1
        },
        "maxContextChars": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputChars": {
          "type": "integer",
          "minimum": 1
        },
        "maxTotalTokens": {
          "type": "integer",
          "minimum": 1
        },
        "maxEscalations": {
          "type": "integer",
          "minimum": 0
        },
        "toolOutput": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxBytes",
            "maxLines",
            "maxLineLength"
          ],
          "properties": {
            "maxBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maxLines": {
              "type": "integer",
              "minimum": 1
            },
            "maxLineLength": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
