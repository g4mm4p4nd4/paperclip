{
  "$schema": "./profit-flywheel.v2.schema.json",
  "schema_version": "profit-flywheel.v2",
  "contract_id": "profit-flywheel",
  "authority": {
    "canonical_author": "portfolio_os",
    "dispatch_authorizer": "portfolio_os",
    "workflow_cockpit": "paperclip",
    "runtime_executor": "hermes",
    "rule": "Consumers may validate and execute this contract, but may not weaken its commercial or transition guards."
  },
  "states": {
    "active": [
      "pending",
      "running",
      "retry"
    ],
    "non_terminal": [
      "blocked",
      "degraded"
    ],
    "terminal": [
      "succeeded",
      "failed",
      "cancelled",
      "safely_skipped"
    ],
    "success": "succeeded"
  },
  "idempotency": {
    "algorithm": "sha256",
    "key_template": "{company}+{run_id}+{stage}+{input_hash}",
    "coalesce_duplicates": true,
    "mutation_receipt_required": true
  },
  "concurrency": {
    "agent_max_concurrent_runs": 1,
    "keys": [
      "provider:{provider}",
      "repo:{target_repo}",
      "stage:{company}:{stage}"
    ],
    "default_limits": {
      "provider": 2,
      "repo": 1,
      "stage": 1
    }
  },
  "recovery": {
    "orphan_timeout_seconds": 900,
    "heartbeat_seconds": 60,
    "resume_from_artifact_checkpoint": true,
    "fresh_transcript_on_provider_failover": true,
    "blocked_receipt_fields": [
      "blocker_code",
      "blocker_detail",
      "next_owner",
      "resume_condition"
    ],
    "never_treat_as_success": [
      "process_exit_zero_without_final_response",
      "missing_completion_artifact",
      "stale_input_hash",
      "missing_required_receipt"
    ]
  },
  "observability": {
    "correlation_id_field": "correlation_id",
    "correlation_span": [
      "portfolio_os_run",
      "paperclip_routine",
      "paperclip_issue",
      "paperclip_run",
      "adapter_invocation",
      "hermes_session",
      "provider_session",
      "target_change",
      "release",
      "learning_receipt"
    ],
    "receipt_format": "stable_json",
    "otel_compatible": true,
    "required_metrics": [
      "stage_latency_seconds",
      "blocked_duration_seconds",
      "retry_count",
      "fallback_count",
      "input_tokens",
      "output_tokens",
      "tool_output_bytes",
      "evidence_freshness_seconds",
      "commercial_outcome"
    ]
  },
  "provider_policy_binding": {
    "mode": "manifest_path_and_sha256",
    "manifest_field": "provider_policy",
    "required_fields": [
      "path",
      "sha256",
      "schema_version",
      "schema_path",
      "schema_sha256"
