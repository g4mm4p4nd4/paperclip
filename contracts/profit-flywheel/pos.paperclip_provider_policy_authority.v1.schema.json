{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-os.local/contracts/pos.paperclip_provider_policy_authority.v1.schema.json",
  "title": "Paperclip provider policy authority v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "provider_policy"],
  "properties": {
    "schema_version": { "const": "pos.paperclip_provider_policy_authority.v1" },
    "authority": { "const": "paperclip_control_plane" },
    "provider_policy": { "$ref": "#/$defs/providerPolicyBinding" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "absolutePath": { "type": "string", "pattern": "^/", "maxLength": 4096 },
    "providerPolicyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema_version", "schema_path", "schema_sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "schema_version": { "const": "provider-policy.v2" },
        "schema_path": { "$ref": "#/$defs/absolutePath" },
        "schema_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
