{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-os.local/contracts/paperclip.research_plan.v3.schema.json",
  "title": "Paperclip Relayed Portfolio OS Iterated Research Plan v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "schema", "authority", "continuation", "target_repo",
    "source_registry", "evidence_families", "query_families", "query",
    "source_requests", "collection_window", "source_plan_hash", "plan_hash", "immutable"
  ],
  "properties": {
    "schema_version": { "const": "paperclip.research_plan.v3" },
    "schema": { "$ref": "#/$defs/artifactBinding" },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_ref", "artifact_sha256", "payload_sha256"],
      "properties": {
        "artifact_ref": { "$ref": "#/$defs/absolutePath" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "payload_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "continuation": { "type": "object" },
    "target_repo": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "source_registry": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "schema_version"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "schema_version": { "const": "pos.research_sources.v2" }
      }
    },
    "evidence_families": { "$ref": "#/$defs/evidenceFamilies" },
    "query_families": { "$ref": "#/$defs/evidenceFamilies" },
    "query": { "$ref": "#/$defs/nonEmptyString" },
    "source_requests": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": { "type": "object" }
    },
    "collection_window": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/dateTime" },
        "to": { "$ref": "#/$defs/dateTime" }
      }
    },
    "source_plan_hash": { "$ref": "#/$defs/sha256" },
    "plan_hash": { "$ref": "#/$defs/sha256" },
    "immutable": { "const": true }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "dateTime": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "absolutePath": { "type": "string", "pattern": "^/", "maxLength": 4096 },
    "artifactBinding": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidenceFamily": {
      "enum": ["repo_activity", "market_signal", "voc", "pricing", "competitive", "differentiation", "distribution", "measured_behavior", "visualization"]
    },
    "evidenceFamilies": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidenceFamily" }
    }
  }
}
