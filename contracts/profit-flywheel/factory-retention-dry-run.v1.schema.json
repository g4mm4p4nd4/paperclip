{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperclip.local/contracts/profit-flywheel/factory-retention-dry-run.v1.schema.json",
  "title": "Paperclip factory retention dry run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "generated_at", "approval_required", "totals", "inventory"],
  "properties": {
    "schema_version": { "const": "paperclip.factory_retention_dry_run.v1" },
    "policy_version": { "const": "zero-touch-factory-retention.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "approval_required": { "const": true },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_count", "eligible_count", "protected_count", "candidate_bytes", "eligible_bytes"],
      "properties": {
        "candidate_count": { "type": "integer", "minimum": 0 },
        "eligible_count": { "type": "integer", "minimum": 0 },
        "protected_count": { "type": "integer", "minimum": 0 },
        "candidate_bytes": { "type": "integer", "minimum": 0 },
        "eligible_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "inventory": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256", "modified_at", "ownership", "lease", "workflow_protection", "archive", "decision", "reason"],
        "properties": {
          "path": { "$ref": "#/$defs/absolutePath" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "modified_at": { "type": "string", "format": "date-time" },
          "ownership": {
            "type": "object",
            "additionalProperties": false,
            "required": ["factory_owned", "token"],
            "properties": {
              "factory_owned": { "type": "boolean" },
              "token": { "type": ["string", "null"], "maxLength": 300 }
            }
          },
          "lease": {
            "type": "object",
            "additionalProperties": false,
            "required": ["active", "expires_at"],
            "properties": {
              "active": { "type": "boolean" },
              "expires_at": { "type": ["string", "null"], "format": "date-time" }
            }
          },
          "workflow_protection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["active", "blocked", "rollback_eligible", "only_referenced_copy"],
            "properties": {
              "active": { "type": "boolean" },
              "blocked": { "type": "boolean" },
              "rollback_eligible": { "type": "boolean" },
              "only_referenced_copy": { "type": "boolean" }
            }
          },
          "archive": {
            "type": "object",
            "additionalProperties": false,
            "required": ["verified", "manifest_path", "manifest_sha256", "object_path"],
            "properties": {
              "verified": { "type": "boolean" },
              "manifest_path": { "type": ["string", "null"], "maxLength": 4096 },
              "manifest_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
              "object_path": { "type": ["string", "null"], "maxLength": 4096 }
            }
          },
          "decision": { "enum": ["protect", "archive_then_review", "eligible_after_approval"] },
          "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "absolutePath": { "type": "string", "pattern": "^/", "minLength": 2, "maxLength": 4096 }
  }
}
