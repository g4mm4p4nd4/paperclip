{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-os.local/contracts/pos.research_portfolio_corroboration.v1.schema.json",
  "title": "Portfolio OS Corroboration Dossier v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "portfolio_run_id",
    "generated_at",
    "primary_artifact_path",
    "primary_artifact_sha256",
    "status",
    "promotion_allowed",
    "exact_exclusions",
    "candidates",
    "lane_reviews"
  ],
  "properties": {
    "schema_version": { "const": "pos.research_portfolio_corroboration.v1" },
    "portfolio_run_id": { "$ref": "#/$defs/id" },
    "generated_at": { "$ref": "#/$defs/dateTime" },
    "primary_artifact_path": { "$ref": "#/$defs/absolutePath" },
    "primary_artifact_sha256": { "$ref": "#/$defs/sha256" },
    "status": { "enum": ["passed", "failed"] },
    "promotion_allowed": { "const": false },
    "exact_exclusions": { "const": ["Glitch-Cipher-Syndicate/LeadForge"] },
    "candidates": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "https://portfolio-os.local/contracts/pos.research_portfolio_primary_dossier.v1.schema.json#/$defs/candidate"
      }
    },
    "lane_reviews": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/laneReview" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
    },
    "nonEmptyString": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "dateTime": { "type": "string", "format": "date-time" },
    "absolutePath": { "type": "string", "pattern": "^/", "maxLength": 4096 },
    "repo": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$",
      "maxLength": 300
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "laneReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "wave_role",
        "review_status",
        "reviewer_provider_family",
        "adjudicated_claim_ids",
        "adjudicated_provider_families",
        "hard_gate_failures",
        "evidence_custody_findings",
        "role_mapping_findings",
        "duplicate_skin_findings",
        "regulated_stop_findings",
        "economics_findings",
        "final_disposition"
      ],
      "properties": {
        "repository": { "$ref": "#/$defs/repo" },
        "wave_role": { "enum": ["exploit", "adjacent", "explore"] },
        "review_status": { "enum": ["passed", "failed"] },
        "reviewer_provider_family": { "$ref": "#/$defs/nonEmptyString" },
        "adjudicated_claim_ids": {
          "type": "array",
          "minItems": 6,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "adjudicated_provider_families": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "hard_gate_failures": { "$ref": "#/$defs/stringList" },
        "evidence_custody_findings": { "$ref": "#/$defs/stringList" },
        "role_mapping_findings": { "$ref": "#/$defs/stringList" },
        "duplicate_skin_findings": { "$ref": "#/$defs/stringList" },
        "regulated_stop_findings": { "$ref": "#/$defs/stringList" },
        "economics_findings": { "$ref": "#/$defs/stringList" },
        "final_disposition": { "enum": ["research_only", "no_go"] }
      }
    }
  }
}
