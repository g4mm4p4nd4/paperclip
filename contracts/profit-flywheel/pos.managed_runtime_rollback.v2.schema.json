{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-os.local/contracts/pos.managed_runtime_rollback.v2.schema.json",
  "title": "Portfolio OS managed runtime rollback descriptor v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "store_root",
    "expected_active_selector_sha256",
    "from_pointer_set",
    "restore_pointer_set",
    "from_runtime",
    "restore_runtime",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "pos.managed_runtime_rollback.v2" },
    "store_root": { "$ref": "#/$defs/absolutePath" },
    "expected_active_selector_sha256": { "$ref": "#/$defs/sha256" },
    "from_pointer_set": { "$ref": "#/$defs/fileBinding" },
    "restore_pointer_set": {
      "oneOf": [
        { "$ref": "#/$defs/fileBinding" },
        { "type": "null" }
      ]
    },
    "from_runtime": { "$ref": "#/$defs/runtimeTarget" },
    "restore_runtime": {
      "oneOf": [
        { "$ref": "#/$defs/runtimeTarget" },
        { "type": "null" }
      ]
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "absolutePath": { "type": "string", "pattern": "^/", "maxLength": 4096 },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtimeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_id", "closure_sha256", "package_root", "package", "runtime_manifest"],
      "properties": {
        "runtime_id": { "type": "string", "pattern": "^portfolio-os-[0-9a-f]{64}$" },
        "closure_sha256": { "$ref": "#/$defs/sha256" },
        "package_root": { "$ref": "#/$defs/absolutePath" },
        "package": { "$ref": "#/$defs/fileBinding" },
        "runtime_manifest": { "$ref": "#/$defs/fileBinding" }
      }
    }
  }
}
