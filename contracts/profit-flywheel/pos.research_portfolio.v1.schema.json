{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-os.local/contracts/pos.research_portfolio.v1.schema.json",
  "title": "Portfolio OS Diversified Research Portfolio v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "portfolio_run_id",
    "generated_at",
    "expires_at",
    "portfolio_run_input_hash",
    "portfolio_hash",
    "source_lineage",
    "provider_policy_authority",
    "provider_budget_authority",
    "provider_receipts",
    "provider_usage_totals",
    "concurrency",
    "extraction",
    "wave_policy",
    "exclusions",
    "lanes",
    "ranking",
    "disposition",
    "promoted_lane_id",
    "promotion_requested",
    "distinct_reskin_approvals",
    "immutable"
  ],
  "properties": {
    "schema_version": { "const": "pos.research_portfolio.v1" },
    "portfolio_run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
    },
    "generated_at": { "$ref": "#/$defs/dateTime" },
    "expires_at": { "$ref": "#/$defs/dateTime" },
    "portfolio_run_input_hash": { "$ref": "#/$defs/sha256" },
    "portfolio_hash": { "$ref": "#/$defs/sha256" },
    "source_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory",
        "research",
        "council",
        "freeze",
        "business",
        "daily",
        "weekly",
        "dashboard",
        "readiness",
        "paperclip_gate"
      ],
      "properties": {
        "inventory": { "$ref": "#/$defs/lineageBinding" },
        "research": { "$ref": "#/$defs/lineageBinding" },
        "council": { "$ref": "#/$defs/lineageBinding" },
        "freeze": { "$ref": "#/$defs/lineageBinding" },
        "business": { "$ref": "#/$defs/lineageBinding" },
        "daily": { "$ref": "#/$defs/lineageBinding" },
        "weekly": { "$ref": "#/$defs/lineageBinding" },
        "dashboard": { "$ref": "#/$defs/lineageBinding" },
        "readiness": { "$ref": "#/$defs/lineageBinding" },
        "paperclip_gate": { "$ref": "#/$defs/lineageBinding" }
      }
    },
    "provider_policy_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "revision",
        "path",
        "sha256",
        "schema_path",
        "schema_sha256"
      ],
      "properties": {
        "schema_version": { "const": "provider-policy.v2" },
        "revision": { "type": "integer", "minimum": 1 },
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "schema_path": { "$ref": "#/$defs/absolutePath" },
        "schema_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "provider_budget_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "path",
        "sha256",
        "max_total_tokens",
        "max_cost_usd",
        "automatic_paid_budget_expansion"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/nonEmptyString" },
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "max_total_tokens": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "max_cost_usd": { "type": "number", "minimum": 0, "maximum": 10000 },
        "automatic_paid_budget_expansion": { "const": false }
      }
    },
    "provider_receipts": {
      "type": "array",
      "minItems": 10,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/providerReceipt" }
    },
    "provider_usage_totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens", "cost_usd"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bounded",
        "max_parallel_lanes",
        "max_parallel_provider_calls",
        "coalesce_duplicates"
      ],
      "properties": {
        "bounded": { "const": true },
        "max_parallel_lanes": { "type": "integer", "minimum": 1, "maximum": 5 },
        "max_parallel_provider_calls": { "type": "integer", "minimum": 1, "maximum": 5 },
        "coalesce_duplicates": { "const": true }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "registered_source_count", "provider_assistance_bounded"],
      "properties": {
        "order": {
          "const": ["deterministic_registered", "provider_assisted"]
        },
        "registered_source_count": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "provider_assistance_bounded": { "const": true }
      }
    },
    "wave_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_count",
        "exploit_lanes",
        "adjacent_lanes",
        "explore_lanes",
        "portfolio_expiry_hours",
        "max_business_model_lanes",
        "max_problem_space_lanes",
        "no_delta_wave_limit",
        "no_delta_day_limit",
        "max_execution_winners"
      ],
      "properties": {
        "lane_count": { "const": 5 },
        "exploit_lanes": { "const": 3 },
        "adjacent_lanes": { "const": 1 },
        "explore_lanes": { "const": 1 },
        "portfolio_expiry_hours": { "const": 24 },
        "max_business_model_lanes": { "const": 3 },
        "max_problem_space_lanes": { "const": 2 },
        "no_delta_wave_limit": { "const": 2 },
        "no_delta_day_limit": { "const": 7 },
        "max_execution_winners": { "const": 1 }
      }
    },
    "exclusions": {
      "const": ["Glitch-Cipher-Syndicate/LeadForge"]
    },
    "lanes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/lane" }
    },
    "ranking": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/rankingEntry" }
    },
    "disposition": {
      "enum": ["research_only", "no_go", "promote_one"]
    },
    "promoted_lane_id": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/laneId" }
      ]
    },
    "promotion_requested": { "type": "boolean" },
    "distinct_reskin_approvals": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "approval_id",
          "core_capability_id",
          "approved_lane_ids",
          "approved_by",
          "approved_at"
        ],
        "properties": {
          "approval_id": { "$ref": "#/$defs/nonEmptyString" },
          "core_capability_id": { "$ref": "#/$defs/coreCapabilityId" },
          "approved_lane_ids": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/laneId" }
          },
          "approved_by": { "$ref": "#/$defs/nonEmptyString" },
          "approved_at": { "$ref": "#/$defs/dateTime" }
        }
      }
    },
    "immutable": { "const": true }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/",
      "maxLength": 4096
    },
    "repo": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$",
      "maxLength": 300
    },
    "laneId": {
      "type": "string",
      "pattern": "^lane-v1-(exploit|adjacent|explore)-[0-9]{2}$"
    },
    "coreCapabilityId": {
      "type": "string",
      "pattern": "^cap\\.v1\\.[0-9a-f]{64}$"
    },
    "marketModel": {
      "enum": ["B2B", "prosumer", "consumer", "B2B2C"]
    },
    "lineageBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "path",
        "sha256",
        "run_id",
        "input_hash",
        "generated_at"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/nonEmptyString" },
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "run_id": { "$ref": "#/$defs/nonEmptyString" },
        "input_hash": { "$ref": "#/$defs/sha256" },
        "generated_at": { "$ref": "#/$defs/dateTime" }
      }
    },
    "researchPlanBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "path", "sha256"],
      "properties": {
        "schema_version": {
          "enum": ["paperclip.research_plan.v2", "paperclip.research_plan.v3"]
        },
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "skin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "market_model", "positioning"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "market_model": { "$ref": "#/$defs/marketModel" },
        "positioning": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "reusableAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "kind", "description"],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "kind": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "marketContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_user",
        "economic_customer",
        "payer",
        "purchase_authority",
        "job_to_be_done",
        "decision_unit",
        "payer_user_relationship",
        "regulated_domain_flags",
        "required_integrations"
      ],
      "properties": {
        "target_user": { "$ref": "#/$defs/nonEmptyString" },
        "economic_customer": { "$ref": "#/$defs/nonEmptyString" },
        "payer": { "$ref": "#/$defs/nonEmptyString" },
        "purchase_authority": { "$ref": "#/$defs/nonEmptyString" },
        "job_to_be_done": { "$ref": "#/$defs/nonEmptyString" },
        "decision_unit": { "$ref": "#/$defs/nonEmptyString" },
        "payer_user_relationship": { "$ref": "#/$defs/nonEmptyString" },
        "regulated_domain_flags": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "required_integrations": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "expectedValueHypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "horizon_months", "low", "base", "high"],
      "properties": {
        "currency": { "const": "USD" },
        "horizon_months": { "const": 12 },
        "low": { "type": "number" },
        "base": { "type": "number" },
        "high": { "type": "number" }
      }
    },
    "capabilityMarketContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_capability_id",
        "capability_primitives",
        "reusable_assets",
        "current_skin",
        "candidate_market_skin",
        "market_contract",
        "incremental_engineering_delta",
        "reuse_percentage",
        "reuse_leverage",
        "evidence_gaps",
        "risks",
        "expected_value",
        "engine_market_fingerprint"
      ],
      "properties": {
        "core_capability_id": { "$ref": "#/$defs/coreCapabilityId" },
        "capability_primitives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "reusable_assets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/reusableAsset" }
        },
        "current_skin": { "$ref": "#/$defs/skin" },
        "candidate_market_skin": { "$ref": "#/$defs/skin" },
        "market_contract": { "$ref": "#/$defs/marketContract" },
        "incremental_engineering_delta": {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw_engineering_days", "engineering_days_after_reuse", "scope"],
          "properties": {
            "raw_engineering_days": { "type": "number", "exclusiveMinimum": 0, "maximum": 3650 },
            "engineering_days_after_reuse": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 3650
            },
            "scope": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        "reuse_percentage": { "type": "number", "minimum": 0, "maximum": 100 },
        "reuse_leverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_gaps": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "risks": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "expected_value": { "$ref": "#/$defs/expectedValueHypothesis" },
        "engine_market_fingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidenceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "url",
        "domain",
        "publisher",
        "title",
        "published_at",
        "accessed_at",
        "attribution",
        "provenance",
        "content_sha256",
        "capture",
        "independent",
        "direct_voc",
        "acquisition_provenance"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "domain": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.-]+$",
          "maxLength": 253
        },
        "publisher": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "published_at": { "$ref": "#/$defs/dateTime" },
        "accessed_at": { "$ref": "#/$defs/dateTime" },
        "attribution": { "$ref": "#/$defs/nonEmptyString" },
        "provenance": {
          "enum": ["registered_extraction", "direct_voc", "primary_measurement", "authoritative_record"]
        },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "capture": { "$ref": "#/$defs/sourceCapture" },
        "independent": { "type": "boolean" },
        "direct_voc": { "type": "boolean" },
        "acquisition_provenance": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/nonEmptyString" }
          ]
        }
      }
    },
    "sourceCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_path",
        "artifact_sha256",
        "artifact_bytes",
        "media_type",
        "captured_at",
        "custody_receipt_path",
        "custody_receipt_sha256"
      ],
      "properties": {
        "artifact_path": { "$ref": "#/$defs/absolutePath" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "artifact_bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "media_type": { "$ref": "#/$defs/nonEmptyString" },
        "captured_at": { "$ref": "#/$defs/dateTime" },
        "custody_receipt_path": { "$ref": "#/$defs/absolutePath" },
        "custody_receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "claimBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_type",
        "claim",
        "author_provider_families",
        "primary_source_ids",
        "corroborating_source_ids",
        "direct_voc_source_ids"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "claim_type": {
          "enum": ["problem", "roles", "demand", "pricing_economics", "risks", "contradictions"]
        },
        "claim": { "$ref": "#/$defs/nonEmptyString" },
        "author_provider_families": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "primary_source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "corroborating_source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "direct_voc_source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "gateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_source_ids", "detail"],
      "properties": {
        "status": {
          "enum": ["pass", "fail", "unknown", "not_applicable"]
        },
        "evidence_source_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "detail": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "competitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "evidence_source_ids"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["competitor", "substitute"] },
        "evidence_source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_source_age_days",
        "sources",
        "claim_bindings",
        "competitors_and_substitutes",
        "contradiction_and_negative_evidence",
        "gates"
      ],
      "properties": {
        "max_source_age_days": { "type": "integer", "minimum": 1, "maximum": 365 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/evidenceSource" }
        },
        "claim_bindings": {
          "type": "array",
          "minItems": 6,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/claimBinding" }
        },
        "competitors_and_substitutes": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/competitor" }
        },
        "contradiction_and_negative_evidence": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim", "evidence_source_ids"],
            "properties": {
              "claim": { "$ref": "#/$defs/nonEmptyString" },
              "evidence_source_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/nonEmptyString" }
              }
            }
          }
        },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "demand",
            "safety",
            "legal",
            "acquisition",
            "evidence",
            "unit_economics",
            "independent_sources",
            "direct_voc",
            "measured_demand",
            "pricing_wtp",
            "competitors_substitutes",
            "authority",
            "contradiction",
            "feasibility",
            "distribution",
            "commercial_inputs",
            "acquisition_cac",
            "activation",
            "retention",
            "variable_costs",
            "privacy_safety",
            "platform_policy",
            "ltv_cac",
            "payback",
            "kill_criteria"
          ],
          "properties": {
            "demand": { "$ref": "#/$defs/gateResult" },
            "safety": { "$ref": "#/$defs/gateResult" },
            "legal": { "$ref": "#/$defs/gateResult" },
            "acquisition": { "$ref": "#/$defs/gateResult" },
            "evidence": { "$ref": "#/$defs/gateResult" },
            "unit_economics": { "$ref": "#/$defs/gateResult" },
            "independent_sources": { "$ref": "#/$defs/gateResult" },
            "direct_voc": { "$ref": "#/$defs/gateResult" },
            "measured_demand": { "$ref": "#/$defs/gateResult" },
            "pricing_wtp": { "$ref": "#/$defs/gateResult" },
            "competitors_substitutes": { "$ref": "#/$defs/gateResult" },
            "authority": { "$ref": "#/$defs/gateResult" },
            "contradiction": { "$ref": "#/$defs/gateResult" },
            "feasibility": { "$ref": "#/$defs/gateResult" },
            "distribution": { "$ref": "#/$defs/gateResult" },
            "commercial_inputs": { "$ref": "#/$defs/gateResult" },
            "acquisition_cac": { "$ref": "#/$defs/gateResult" },
            "activation": { "$ref": "#/$defs/gateResult" },
            "retention": { "$ref": "#/$defs/gateResult" },
            "variable_costs": { "$ref": "#/$defs/gateResult" },
            "privacy_safety": { "$ref": "#/$defs/gateResult" },
            "platform_policy": { "$ref": "#/$defs/gateResult" },
            "ltv_cac": { "$ref": "#/$defs/gateResult" },
            "payback": { "$ref": "#/$defs/gateResult" },
            "kill_criteria": { "$ref": "#/$defs/gateResult" }
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probability",
        "revenue",
        "acquisition_cost",
        "infrastructure_cost",
        "platform_fees",
        "payment_fees",
        "refund_cost",
        "moderation_cost",
        "support_cost",
        "net_contribution",
        "evidence_source_ids"
      ],
      "properties": {
        "probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "revenue": { "type": "number", "minimum": 0 },
        "acquisition_cost": { "type": "number", "minimum": 0 },
        "infrastructure_cost": { "type": "number", "minimum": 0 },
        "platform_fees": { "type": "number", "minimum": 0 },
        "payment_fees": { "type": "number", "minimum": 0 },
        "refund_cost": { "type": "number", "minimum": 0 },
        "moderation_cost": { "type": "number", "minimum": 0 },
        "support_cost": { "type": "number", "minimum": 0 },
        "net_contribution": { "type": "number" },
        "evidence_source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "consumerMetrics": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "acquisition_mode",
            "cac_or_organic_reach",
            "activation_rate",
            "retention_proxy",
            "ltv_cac_ratio",
            "payback_months",
            "privacy_gate",
            "safety_gate",
            "platform_policy_gate",
            "cancellation_refund_support_assumptions",
            "evidence_source_ids"
          ],
          "properties": {
            "acquisition_mode": { "$ref": "#/$defs/nonEmptyString" },
            "cac_or_organic_reach": { "type": "number", "exclusiveMinimum": 0 },
            "activation_rate": { "type": "number", "minimum": 0, "maximum": 1 },
            "retention_proxy": { "type": "number", "minimum": 0, "maximum": 1 },
            "ltv_cac_ratio": { "type": "number", "minimum": 0 },
            "payback_months": { "type": "number", "minimum": 0 },
            "privacy_gate": { "enum": ["pass", "fail", "unknown"] },
            "safety_gate": { "enum": ["pass", "fail", "unknown"] },
            "platform_policy_gate": { "enum": ["pass", "fail", "unknown"] },
            "cancellation_refund_support_assumptions": { "$ref": "#/$defs/nonEmptyString" },
            "evidence_source_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        }
      ]
    },
    "economics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "horizon_months",
        "low",
        "base",
        "high",
        "probability_weighted_12m_net_contribution",
        "engineering_days_after_reuse",
        "time_to_first_revenue_days",
        "normalized_value_score",
        "consumer_metrics"
      ],
      "properties": {
        "currency": { "const": "USD" },
        "horizon_months": { "const": 12 },
        "low": { "$ref": "#/$defs/scenario" },
        "base": { "$ref": "#/$defs/scenario" },
        "high": { "$ref": "#/$defs/scenario" },
        "probability_weighted_12m_net_contribution": { "type": "number" },
        "engineering_days_after_reuse": { "type": "number", "exclusiveMinimum": 0 },
        "time_to_first_revenue_days": { "type": "number", "exclusiveMinimum": 0 },
        "normalized_value_score": { "type": "number" },
        "consumer_metrics": { "$ref": "#/$defs/consumerMetrics" }
      }
    },
    "laneOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hard_gate_pass",
        "eligible_for_promotion",
        "failed_gates",
        "research_disposition",
        "kill_criteria"
      ],
      "properties": {
        "hard_gate_pass": { "type": "boolean" },
        "eligible_for_promotion": { "type": "boolean" },
        "failed_gates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "research_disposition": {
          "enum": ["continue_research", "research_only", "no_go", "eligible"]
        },
        "kill_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "pinState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_fingerprint",
        "venture_fingerprint",
        "engine_market_fingerprint",
        "no_delta_wave_count",
        "pinned_since",
        "changed_input_hash",
        "action"
      ],
      "properties": {
        "hypothesis_fingerprint": { "$ref": "#/$defs/sha256" },
        "venture_fingerprint": { "$ref": "#/$defs/sha256" },
        "engine_market_fingerprint": { "$ref": "#/$defs/sha256" },
        "no_delta_wave_count": { "type": "integer", "minimum": 0 },
        "pinned_since": { "$ref": "#/$defs/dateTime" },
        "changed_input_hash": { "type": "boolean" },
        "action": { "enum": ["keep", "rotate", "kill"] }
      }
    },
    "idempotencyRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "input_hash", "key"],
      "properties": {
        "stage": {
          "enum": ["extraction", "evidence", "economics", "ranking", "promotion"]
        },
        "input_hash": { "$ref": "#/$defs/sha256" },
        "key": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "independentReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_family",
        "primary_provider_family",
        "different_provider_family",
        "artifact_path",
        "artifact_sha256",
        "input_hash",
        "adjudicated_claim_ids",
        "adjudicated_provider_families",
        "status"
      ],
      "properties": {
        "provider_family": { "$ref": "#/$defs/nonEmptyString" },
        "primary_provider_family": { "$ref": "#/$defs/nonEmptyString" },
        "different_provider_family": { "const": true },
        "artifact_path": { "$ref": "#/$defs/absolutePath" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "input_hash": { "$ref": "#/$defs/sha256" },
        "adjudicated_claim_ids": {
          "type": "array",
          "minItems": 6,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "adjudicated_provider_families": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "status": { "enum": ["passed", "failed"] }
      }
    },
    "providerReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "lane_id",
        "purpose",
        "provider_family",
        "route_id",
        "provider_policy_sha256",
        "transcript_path",
        "transcript_sha256",
        "fresh_transcript",
        "hidden_fallback_used",
        "input_tokens",
        "output_tokens",
        "cost_usd",
        "started_at",
        "finished_at",
        "route_changed",
        "previous_route_id",
        "attempt_number",
        "attempt_limit",
        "fallback_reason"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        },
        "lane_id": { "$ref": "#/$defs/laneId" },
        "purpose": { "enum": ["primary_research", "independent_review"] },
        "provider_family": { "$ref": "#/$defs/nonEmptyString" },
        "route_id": { "$ref": "#/$defs/nonEmptyString" },
        "provider_policy_sha256": { "$ref": "#/$defs/sha256" },
        "transcript_path": { "$ref": "#/$defs/absolutePath" },
        "transcript_sha256": { "$ref": "#/$defs/sha256" },
        "fresh_transcript": { "const": true },
        "hidden_fallback_used": { "const": false },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "started_at": { "$ref": "#/$defs/dateTime" },
        "finished_at": { "$ref": "#/$defs/dateTime" },
        "route_changed": { "type": "boolean" },
        "attempt_number": { "type": "integer", "minimum": 1, "maximum": 3 },
        "attempt_limit": { "type": "integer", "minimum": 1, "maximum": 3 },
        "previous_route_id": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/nonEmptyString" }
          ]
        },
        "fallback_reason": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/nonEmptyString" }
          ]
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_id",
        "lane_version",
        "wave_role",
        "repo",
        "capability_family",
        "problem_family",
        "market_family",
        "market_model",
        "business_model",
        "problem_space",
        "research_plan",
        "capability_market_contract",
        "evidence",
        "economics",
        "outcome",
        "pin",
        "idempotency",
        "provider_receipt_hashes",
        "primary_provider_family",
        "independent_review",
        "distinct_reskin_approval_id",
        "input_hash"
      ],
      "properties": {
        "lane_id": { "$ref": "#/$defs/laneId" },
        "lane_version": { "const": 1 },
        "wave_role": { "enum": ["exploit", "adjacent", "explore"] },
        "repo": { "$ref": "#/$defs/repo" },
        "capability_family": { "$ref": "#/$defs/nonEmptyString" },
        "problem_family": { "$ref": "#/$defs/nonEmptyString" },
        "market_family": { "$ref": "#/$defs/nonEmptyString" },
        "market_model": { "$ref": "#/$defs/marketModel" },
        "business_model": { "$ref": "#/$defs/nonEmptyString" },
        "problem_space": { "$ref": "#/$defs/nonEmptyString" },
        "research_plan": { "$ref": "#/$defs/researchPlanBinding" },
        "capability_market_contract": { "$ref": "#/$defs/capabilityMarketContract" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "economics": { "$ref": "#/$defs/economics" },
        "outcome": { "$ref": "#/$defs/laneOutcome" },
        "pin": { "$ref": "#/$defs/pinState" },
        "idempotency": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/idempotencyRecord" }
        },
        "provider_receipt_hashes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "primary_provider_family": { "$ref": "#/$defs/nonEmptyString" },
        "independent_review": { "$ref": "#/$defs/independentReview" },
        "distinct_reskin_approval_id": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/nonEmptyString" }
          ]
        },
        "input_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "rankingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "lane_id",
        "hard_gate_pass",
        "eligible_for_promotion",
        "probability_weighted_12m_net_contribution",
        "engineering_days_after_reuse",
        "time_to_first_revenue_days",
        "normalized_value_score"
      ],
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 5 },
        "lane_id": { "$ref": "#/$defs/laneId" },
        "hard_gate_pass": { "type": "boolean" },
        "eligible_for_promotion": { "type": "boolean" },
        "probability_weighted_12m_net_contribution": { "type": "number" },
        "engineering_days_after_reuse": { "type": "number", "exclusiveMinimum": 0 },
        "time_to_first_revenue_days": { "type": "number", "exclusiveMinimum": 0 },
        "normalized_value_score": { "type": "number" }
      }
    }
  }
}
