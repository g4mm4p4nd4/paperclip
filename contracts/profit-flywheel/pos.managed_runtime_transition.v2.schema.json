{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-os.local/contracts/pos.managed_runtime_transition.v2.schema.json",
  "title": "Portfolio OS managed runtime transition receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "store_root",
    "before_selector_sha256",
    "after_selector_sha256",
    "activated_pointer_set",
    "rollback_descriptor",
    "observed_at"
  ],
  "properties": {
    "schema_version": { "const": "pos.managed_runtime_transition.v2" },
    "operation": { "enum": ["promote", "rollback"] },
    "store_root": { "$ref": "#/$defs/absolutePath" },
    "before_selector_sha256": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "after_selector_sha256": { "$ref": "#/$defs/sha256" },
    "activated_pointer_set": { "$ref": "#/$defs/fileBinding" },
    "rollback_descriptor": {
      "oneOf": [
        { "$ref": "#/$defs/fileBinding" },
        { "type": "null" }
      ]
    },
    "observed_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "absolutePath": { "type": "string", "pattern": "^/", "maxLength": 4096 },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
